# ============================================================
# FlowUp - variaveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env de verdade (ja esta no .gitignore).

# Connection string do Postgres
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/hackathon

# Chave secreta usada para assinar JWTs (HS256).
# Para gerar uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
